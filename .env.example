# =============================================================================
# Environment variables for the portfolio + AI chat endpoint.
# Copy to `.env.local` and fill in real values. NEVER commit `.env.local`.
# Every variable here is server-only — do NOT prefix any of them with
# NEXT_PUBLIC_, or the value will be exposed in the browser bundle.
# =============================================================================

# ---- Anthropic (required for the chat assistant) ----------------------------
# Use a DEDICATED Anthropic key for this app so it can be rotated or revoked
# independently of your other projects. Set a spend limit on it (see
# docs/SECURITY_DEPLOYMENT.md). Server-only.
ANTHROPIC_API_KEY=

# ---- Upstash Redis (distributed rate limiting) ------------------------------
# REST credentials from the Upstash console. REQUIRED in production for real,
# cross-instance rate limiting. If unset, the app falls back to a best-effort,
# per-instance in-memory limiter that is only acceptable for local development.
# Server-only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Chat safety controls (optional; secure defaults shown) -----------------
# Master kill switch. Set to "false" to instantly disable the endpoint (503).
CHAT_ENABLED=true
# Per-client request rate (rolling 60s window).
CHAT_MAX_REQUESTS_PER_MINUTE=8
# Concurrent in-flight generations allowed per client.
CHAT_MAX_CONCURRENT_PER_CLIENT=2
# Global daily generation cap across all clients (cost safety net; 0 disables).
CHAT_GLOBAL_DAILY_LIMIT=2000
# Reserved for a future server-side history contract.
CHAT_MAX_MESSAGES=10
# Max characters in a single user message.
CHAT_MAX_MESSAGE_LENGTH=1500
# Absolute upper bound on decoded message characters.
CHAT_MAX_TOTAL_CHARACTERS=8000
# max_tokens sent to the model (caps output cost).
CHAT_MAX_OUTPUT_TOKENS=400
# Reject request bodies larger than this many bytes (413).
CHAT_MAX_REQUEST_BODY_BYTES=32000
# Abort the upstream model call after this many milliseconds.
CHAT_REQUEST_TIMEOUT_MS=30000

# ---- Miscellaneous (optional) -----------------------------------------------
# Random per-deployment salt used to one-way hash client IPs in logs and
# rate-limit keys. Generate with e.g. `openssl rand -hex 16`.
IP_HASH_SALT=
# Extra allowed browser origins, comma-separated (e.g. a preview domain).
# The production apex + www origins are always allowed.
ALLOWED_ORIGINS=
